{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI4Instruments agent-instrument catalogue",
  "type": "object",
  "required": ["schema_version", "reviewed", "projects"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reviewed": {"type": "string", "format": "date"},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/project"}}
  },
  "additionalProperties": false,
  "$defs": {
    "bilingual": {"type": "object", "required": ["zh", "en"], "properties": {"zh": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "source": {"type": "object", "required": ["role", "url"], "properties": {"role": {"enum": ["overview", "license", "implementation", "paper"]}, "url": {"type": "string", "format": "uri"}}, "additionalProperties": false},
    "project": {
      "type": "object",
      "required": ["id", "name", "repository", "url", "category", "scope", "interfaces", "mcp", "skills", "license", "license_class", "description", "evidence", "sources", "related", "reviewed", "snapshot_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "url": {"type": "string", "format": "uri"},
        "category": {"enum": ["protocol", "runtime", "measurement", "microscopy", "quantum", "chemistry", "industrial", "embedded", "robotics", "gui"]},
        "scope": {"enum": ["implementation", "reference"]},
        "interfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "mcp": {"enum": ["documented", "not_documented"]},
        "skills": {"enum": ["documented", "not_documented"]},
        "license": {"type": "string"},
        "license_class": {"enum": ["open", "mixed", "restricted", "unspecified"]},
        "description": {"$ref": "#/$defs/bilingual"},
        "evidence": {"type": "object", "required": ["kind", "zh", "en"], "properties": {"kind": {"enum": ["experiment", "hardware", "adapter", "simulation", "artifact", "proposal"]}, "zh": {"type": "string"}, "en": {"type": "string"}}, "additionalProperties": false},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "related": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reviewed": {"type": "string", "format": "date"},
        "snapshot_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      },
      "additionalProperties": false
    }
  }
}
