{
  "type": "object",
  "required": [
    "schema_version",
    "updated",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[pardfs]:"
          },
          "kind": {
            "enum": [
              "project",
              "actor",
              "route",
              "domain",
              "standard",
              "foundation"
            ]
          },
          "label": {
            "type": "object",
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "kind",
          "basis",
          "sources",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "maintained_by",
              "publishes",
              "uses",
              "successor",
              "documents",
              "related",
              "classified_route",
              "classified_domain"
            ]
          },
          "basis": {
            "enum": [
              "documented",
              "analysis"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "note": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "zh",
                  "en"
                ],
                "properties": {
                  "zh": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "documented"
                }
              }
            },
            "then": {
              "properties": {
                "sources": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI4Instruments typed relationship graph"
}
