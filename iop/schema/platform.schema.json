{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Platform",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "devices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "devices": {
      "$ref": "#/$defs/strings"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "devices"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "devices": {
            "allOf": [
              {
                "$ref": "#/$defs/strings"
              },
              {
                "minItems": 1
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "operations": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/strings"
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "object",
            "required": [
              "device",
              "port"
            ],
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "to": {
            "type": "object",
            "required": [
              "device",
              "port"
            ],
            "properties": {
              "device": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "procedures": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "required": [
                "id",
                "device",
                "operation"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "device": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "type": "string",
                  "minLength": 1
                },
                "arguments": {
                  "type": "object"
                },
                "after": {
                  "$ref": "#/$defs/strings"
                },
                "resources": {
                  "$ref": "#/$defs/strings"
                },
                "requirements": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "bindings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "step"
                    ],
                    "properties": {
                      "step": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "resources": {
            "$ref": "#/$defs/strings"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
