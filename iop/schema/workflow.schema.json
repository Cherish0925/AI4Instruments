{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOP Workflow",
  "type": "object",
  "required": [
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "platform_revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/strings"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "parameters": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "device",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "after": {
            "$ref": "#/$defs/strings"
          },
          "resources": {
            "$ref": "#/$defs/strings"
          },
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "step"
              ],
              "properties": {
                "step": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
